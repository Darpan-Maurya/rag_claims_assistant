# App
APP_NAME=RAG Claims Assistant
APP_ENV=development
RAG_API_KEY=change-this-local-api-key
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
LOG_FULL_QUERIES=false

# Gemini
# Keep blank to use deterministic analytics/RAG fallback answers only.
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash

# Local supervised intent-and-safety classifier used by the router and guardrails.
QUERY_CLASSIFIER_MODEL_PATH=models/query_classifier.joblib
ROUTER_MIN_CONFIDENCE=0.40
GUARDRAIL_MIN_CONFIDENCE=0.55

# Optional public web search. Disabled by default; it is only selected for
# explicit/current public-information requests, never for claims-data questions.
WEB_SEARCH_PROVIDER=disabled
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=12
# Comma-separated allowlist, e.g. cms.gov,medicare.gov
WEB_SEARCH_ALLOWED_DOMAINS=

# Retrieval
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ENABLE_RERANKER=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# Dense cosine similarity is used for unfiltered semantic-search gating. RRF is
# used only to order results and must not be thresholded.
MIN_DENSE_RELEVANCE_SCORE=0.20
DEFAULT_TOP_K=10
MAX_TOP_K=50
MAX_QUERY_CHARS=1200

# Qdrant
# Leave QDRANT_URL blank for embedded local Qdrant. Docker Compose overrides it.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=claims_chunks
QDRANT_LOCAL_PATH=data/qdrant

# Redis query cache
# Leave REDIS_URL blank for local runs without Redis. Docker Compose overrides it.
REDIS_URL=
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL_SECONDS=300

# Storage paths
RAW_DATA_PATH=data/raw/claims.csv
PROCESSED_DATA_PATH=data/processed/claims_processed.parquet
DATASET_MANIFEST_PATH=data/processed/dataset_manifest.json
RAG_METADATA_PATH=rag/metadata.parquet
CHUNK_METADATA_PATH=rag/chunk_metadata.parquet
SQLITE_PATH=data/app_state.sqlite3

# UI
# Docker Compose uses http://api:8000 internally; native local runs use 127.0.0.1.
API_BASE_URL=http://127.0.0.1:8000

# RBAC: JSON must remain on one line.
RAG_RBAC_USERS=[]
